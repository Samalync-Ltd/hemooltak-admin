# Copy to `.env` (gitignored) and adjust as needed.

# When "true", the app talks to the local Firebase emulator suite
# (firebase emulators:start --only auth,functions,firestore,storage, run from
# hemooltak-backend) instead of production Firebase. Keep this true for local
# development against the emulators.
VITE_USE_EMULATORS=

# Same `hemooltak` Firebase project the backend deploys to (see
# hemooltak-backend/INTEGRATION.md).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Region the hemooltak-backend Cloud Functions are deployed to. Must match
# REGION in hemooltak-backend/functions/src/constants.ts, or every call fails.
VITE_FUNCTIONS_REGION=
