# Copy to `.env` (gitignored) and adjust as needed.

# When "true", the app talks to the local Firebase emulator suite
# (firebase emulators:start --only auth,functions,firestore,storage, run from
# hemooltak-backend) instead of production Firebase. Keep this true for local
# development against the emulators.
VITE_USE_EMULATORS=true

# Same `hemooltak` Firebase project the backend deploys to (see
# hemooltak-backend/INTEGRATION.md). All Cloud Functions run in
# me-central2 — see src/firebase/config.js.
VITE_FIREBASE_API_KEY=AIzaSyDGp022Eznp6C5KJweMfaaDsc4s10zxm0w
VITE_FIREBASE_AUTH_DOMAIN=hemooltak.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hemooltak
VITE_FIREBASE_STORAGE_BUCKET=hemooltak.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=230557526746
VITE_FIREBASE_APP_ID=1:230557526746:web:e46df5ab47f8928b8593e3
